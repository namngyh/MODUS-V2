/*********************************************************
 *  PRICE + ST (SuperTrend) + KF + EMA300 + SIGNALS
 *  + DD (points) — ch?n b?ng chartType
 *  - DD tính theo ÐI?M, không theo %
 *********************************************************/

_SECTION_BEGIN("KESL_Q1-21 (chartType control)");

// ========== HI?N TH? & BACKTEST ==========
SetChartOptions(0, chartShowArrows | chartShowDates);
OptimizerSetEngine("cmae");
SetOption("ExtraColumnsLocation", 1);
SetPositionSize(1, spsShares);
SetOption("InitialEquity", 2000);
SetTradeDelays(0,0,0,0);

// ========== CH?N LO?I PANE HI?N TH? ==========
chartType = ParamList("Show Kieu Chart:", "Price|Signals|DD (points)", 0);

// ========== THAM S? SUPER TREND ==========
Factor = Optimize("ST Factor", 3, 1, 10, 0.5);
Pd     = Optimize("ST ATR",    28, 1, 100, 1);

// ========== SUPER TREND TÍNH TOÁN ==========
Up   = (H+L+C)/3 + (Factor*ATR(Pd));
Dn   = (H+L+C)/3 - (Factor*ATR(Pd));
iATR = ATR(Pd);

TrendUp = TrendDown = Null;
trend   = Null;
trend[0]= 1;
changeOfTrend = 0;
flag = flagh = 0;

for (i = 1; i < BarCount; i++)
{
    TrendUp[i] = TrendDown[i] = Null;
    trend[i] = trend[i-1];

    if (C[i] > Up[i-1])      { trend[i] =  1; if (trend[i-1] == -1) changeOfTrend = 1; }
    else if (C[i] < Dn[i-1]) { trend[i] = -1; if (trend[i-1] ==  1) changeOfTrend = 1; }
    else                     { changeOfTrend = 0; }

    flag  = IIf(trend[i] < 0 AND trend[i-1] > 0, 1, 0);
    flagh = IIf(trend[i] > 0 AND trend[i-1] < 0, 1, 0);

    if (trend[i] > 0 AND Dn[i] < Dn[i-1]) Dn[i] = Dn[i-1];
    if (trend[i] < 0 AND Up[i] > Up[i-1]) Up[i] = Up[i-1];

    if (flag )  Up[i] = (H[i]+L[i])/2 + (Factor*iATR[i]);
    if (flagh)  Dn[i] = (H[i]+L[i])/2 - (Factor*iATR[i]);

    if (trend[i] ==  1)
    {
        TrendUp[i] = Dn[i];
        if (changeOfTrend) { TrendUp[i-1] = TrendDown[i-1]; changeOfTrend = 0; }
    }
    else
    {
        TrendDown[i] = Up[i];
        if (changeOfTrend) { TrendDown[i-1] = TrendUp[i-1]; changeOfTrend = 0; }
    }
}

Buy2   = Flip(trend== 1, trend==-1);
Short2 = Flip(trend==-1, trend== 1);

// ========== THAM S? KF ==========
periods     = Optimize("KF Periods",       22, 10, 90, 1);
Ksmooth     = Optimize("KF %K avg",        43, 10, 90, 1);
regperiods  = Optimize("KF LinRegPeriods", 54, 10, 90, 1);
maperiods   = Optimize("KF MAPeriods",     34, 10, 90, 1);
n1          = Optimize("KF N1",            3.7, 1, 9, 0.1);

// ========== KF TÍNH TOÁN ==========
LRSI        = LinearReg(RSI(periods), regperiods);
LSTO        = LinearReg(StochK(periods, Ksmooth), regperiods);
STORSI      = (n1*LRSI + LSTO);
STORSIma    = WMA(STORSI, maperiods);

HisKF       = STORSI - STORSIma;

Buy1   = Flip( Cross(STORSI, STORSIma), Cross(STORSIma, STORSI) );
Short1 = Flip( Cross(STORSIma, STORSI), Cross(STORSI, STORSIma) );

// ========== EMA300 FILTER ==========
emaperiod = Optimize("EMA Periods", 300, 200, 500, 10);
ema300    = EMA(Close, emaperiod);

// ========== TÍN HI?U VÀO/RA (tính s?n d? Equity dùng du?c ? m?i ch? d?) ==========
BuySig   = Buy1   AND Buy2;
ShortSig = Short1 AND Short2;

Buy   = BuySig   AND C > ema300;
Short = ShortSig AND C < ema300;

Sell  = ShortSig;   // d?o chi?u
Cover = BuySig;     // d?o chi?u

// Lo?i trùng
Buy   = ExRem(Buy,  Sell);
Sell  = ExRem(Sell, Buy);
Short = ExRem(Short, Cover);
Cover = ExRem(Cover, Short);

// Giá vào/ra (dùng Close)
BuyPrice = ShortPrice = SellPrice = CoverPrice = Close;

// ====== TIÊU Ð? CHUNG ======
_N( Title = StrFormat("{{NAME}} - {{INTERVAL}} {{DATE}}  O %g  H %g  L %g  C %g (%.1f%%)  {{VALUES}}",
    O,H,L,C, SelectedValue(ROC(C,1)) ) );

// ========== HI?N TH? THEO chartType ==========

// 1) CH? GIÁ (Price)
if (chartType == "Price")
{
    Plot( C, "Close", ParamColor("Color", colorDarkGrey),
          styleNoTitle | ParamStyle("Style") | GetPriceStyle() );
}

// 2) PANE SIGNALS (SuperTrend + KF + EMA300 + Mui tên & Nhãn)
else if (chartType == "Signals")
{
    // Giá + EMA300
    Plot( C, "Price", colorDefault, styleCandle );
    Plot( ema300, "EMA"+emaperiod, colorBlue, styleThick );

    // SuperTrend lines
    Plot( TrendUp,   "ST Up",   colorPink );
    Plot( TrendDown, "ST Down", colorYellow );

    // KF markers t?i giao c?t
    PlotShapes(IIf(Cross(STORSI, STORSIma),   shapeHollowUpTriangle,   shapeNone), colorGreen,  0, Low,  -45);
    PlotShapes(IIf(Cross(STORSIma, STORSI),   shapeHollowDownTriangle, shapeNone), colorOrange, 0, High, -55);

    // Entry/Exit mui tên
    Offset = 20;
    PlotShapes(IIf(Buy,   shapeUpTriangle,   shapeNone), colorBrightGreen, 0, Low,  -Offset);
    PlotShapes(IIf(Short, shapeDownTriangle, shapeNone), colorRed,         0, High, -Offset);
    PlotShapes(IIf(Sell,  shapeStar,         shapeNone), colorCustom12,    0, High, -Offset-15);
    PlotShapes(IIf(Cover, shapeStar,         shapeNone), colorCustom12,    0, Low,  -Offset-15);

    // Nhãn giá
    for (i = 0; i < BarCount; i++)
    {
        yoffset = 50;
        if (Buy[i])   PlotText("BUY\n"   + C[i], i, L[i], colorCustom9,  colorDefault, -yoffset);
        if (Short[i]) PlotText("SHORT\n" + C[i], i, H[i], colorCustom5,  colorDefault,  yoffset);
        if (Sell[i])  PlotText("SELL\n"  + C[i], i, H[i], colorCustom12, colorDefault,  yoffset+20);
        if (Cover[i]) PlotText("COVER\n" + C[i], i, L[i], colorCustom12, colorDefault, -yoffset-20);
    }
}

// 3) PANE DD (POINTS) — ch? DD & MDD
else if (chartType == "DD (points)")
{
    // Equity d?a trên tín hi?u dã tính ? trên
    eq    = Equity(1);
    maxEq = HHV(eq, BarCount);
    dd    = eq - maxEq;          // DD theo di?m (âm)
    mdd   = LLV(dd, BarCount);   // MDD theo di?m (âm)

    _N(Title = StrFormat("{{NAME}} - DD (points) | DD: %.1f | MDD: %.1f",
              SelectedValue(dd), SelectedValue(mdd)));

    // grid theo di?m, không %
    SetChartOptions(2, 0, 0);
    SetGradientFill(GetChartBkColor(), ColorRGB(10,25,60), 0);

    // V? DD & MDD — ch? pane này
    Plot(dd,  "DD (pts)",  colorBlue,
         styleGradient | styleLine | styleThick | styleOwnScale | styleNoTitle);
    Plot(mdd, "MDD (pts)", colorRed,
         styleLine | styleThick | styleOwnScale | styleNoTitle);

    // baseline 0
    Plot(0, "", colorGrey50, styleLine | styleNoTitle | styleOwnScale);
}

_SECTION_END();
